// Типи, неявне та явне приведення
package main

import "fmt"

func main() {
	var i int = 7
	var f float = 2        // int-літерал неявно розширюється до float
	a := i / 2             // int / int → int: 3 (відкидання дробової частини)
	b := i / 2.0           // int / float → float: 3.5
	c := float(i) / 2      // явне приведення: 3.5
	d := int(-3.9)         // відкидання дробової частини в бік нуля: -3
	e := i % 4             // остача: 3
	s := "Kr" + "ok"       // конкатенація рядків
	fmt.Println(a, b, c, d, e, s, f ** 2, len(s))
}
